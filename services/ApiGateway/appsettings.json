{
  "ReverseProxy": {
    "Routes": {
      "incidentsRoute": {
        "ClusterId": "incidentCluster",
        "Match": {
          "Path": "/api/incidents/{**catch-all}"
        }
      },
      "logsRoute": {
        "ClusterId": "logCluster",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "incidentCluster": {
        "Destinations": {
          "incidentService": {
            "Address": "http://incidentservice:8080/"
          }
        }
      },
      "logCluster": {
        "Destinations": {
          "logService": {
            "Address": "http://logservice:8080/"
          }
        }
      }
    }
  }
}