{
  "ReverseProxy": {
    "Routes": {
      "logsRoute": {
        "ClusterId": "logsCluster",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        }
      },

      "incidentsRoute": {
        "ClusterId": "incidentsCluster",
        "Match": {
          "Path": "/api/incidents/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "logsCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://logservice:8080/"
          }
        }
      },

      "incidentsCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://incidentservice:8080/"
          }
        }
      }
    }
  }
}