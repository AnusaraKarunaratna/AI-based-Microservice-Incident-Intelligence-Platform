{
  "title": "Incident Intelligence Platform",
  "uid": "incident-intelligence",
  "version": 1,
  "schemaVersion": 36,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate - API Gateway",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total{job=\"apigateway\"}[1m])",
          "legendFormat": "{{method}} {{path}} {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Request Rate - Log Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total{job=\"logservice\"}[1m])",
          "legendFormat": "{{method}} {{path}} {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Rate - Incident Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total{job=\"incidentservice\"}[1m])",
          "legendFormat": "{{method}} {{path}} {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Duration P99 (all services)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{job}} p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(http_requests_received_total{code=~\"5..\"}[1m])",
          "legendFormat": "{{job}} {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "In-Flight Requests",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "http_requests_in_progress",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ]
}